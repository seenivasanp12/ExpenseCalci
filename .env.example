# Copy this file to .env and fill in your values.
# Get Supabase credentials from: Supabase Dashboard → Project Settings → API

# ── Backend ──────────────────────────────────────────────────────────────────
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-strong-random-secret-here
ADMIN_PASSWORD=your-strong-admin-password-here

# Comma-separated list of allowed frontend origins (no trailing slash)
# Local dev → http://localhost:5173
# Production → https://your-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend (Supabase) ───────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_ADMIN_PASSWORD=your-strong-admin-password-here

# ── Android / Mobile builds ──────────────────────────────────────────────────
# Leave blank for web dev (Vite proxy handles it).
# Android emulator  → VITE_API_URL=http://10.0.2.2:3001
# Real device (LAN) → VITE_API_URL=http://192.168.x.x:3001  (your machine's LAN IP)
# Production        → VITE_API_URL=https://your-backend.example.com
VITE_API_URL=
